SECRET_KEY=change-me
LOG_LEVEL=INFO
GEMINI_API_KEY=
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
ALLOWED_HOSTS=localhost
CSRF_TRUSTED_ORIGINS=
USE_HTTPS=True
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
FIELD_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Readable path INSIDE the backend runtime to the Firebase service-account JSON.
# Empty disables FCM. Use the same project as the frontend Firebase/VAPID config.
# Production Compose overrides this with /run/secrets/firebase_admin.
# Setup, frontend contract and event matrix: docs/PUSH_NOTIFICATIONS.md
FIREBASE_CREDENTIALS=
MP_ACCESS_TOKEN=
# Browser app origin (not /api/v1); HTTPS is required for FCM notification click links.
FRONTEND_URL=http://localhost:5173
REDIS_URL=redis://localhost:6379/0
